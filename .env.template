# Copy to .env and point at your Keycloak.
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Modern Keycloak has no /auth path prefix.
KC_AUTH_SERVER_URL=http://localhost:8080
KC_REALM=your-realm

# Optional: enables audience validation. Requires an audience mapper on
# your realm's client — Keycloak does not put your API in `aud` by default.
#KC_RESOURCE=your-api-client

# Optional: set when clients reach Keycloak on a different URL than this
# server does (Docker/internal networks) — the token's `iss` must match.
#KC_ISSUER=http://localhost:8080/realms/your-realm
